# ── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Scraper ───────────────────────────────────────────────────────────────────
FIRSTCRY_SEARCH_URL=https://www.firstcry.com/search?q=hot+wheels
CHECK_INTERVAL_MINUTES=10
# If >0, overrides CHECK_INTERVAL_MINUTES (scrape typically takes 2-4s/run)
CHECK_INTERVAL_SECONDS=0
# Max pages to scrape per run (0 = scrape the whole catalog, auto-detected)
MAX_PAGES=0
# Concurrent page fetches (top-down + bottom-up scan in parallel)
SCRAPE_CONCURRENCY=10

# ── Pincode ───────────────────────────────────────────────────────────────────
DEFAULT_PINCODE=400001

# ── Email Notifications ───────────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your@gmail.com
EMAIL_TO=notify@example.com

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── WhatsApp via Twilio (optional) ────────────────────────────────────────────
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+919876543210
